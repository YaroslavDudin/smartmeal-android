[Unit]
Description=gunicorn daemon for SmartMeal
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/root/smartmeal-android/server
# Подгружаем переменные напрямую
EnvironmentFile=/root/smartmeal-android/server/.env
ExecStart=/root/smartmeal-android/server/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/root/smartmeal-android/server/smartmeal.sock \
    config.wsgi:application

[Install]
WantedBy=multi-user.target